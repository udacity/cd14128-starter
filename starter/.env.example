# Database connection — these defaults match the Udacity workspace.
# Running locally? See "Optional — Local Environment Setup" in the classroom.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cms

# ENV must be exactly "development" or "production".
# development → GORM AutoMigrate runs on startup.
# production  → migrations must be applied manually with golang-migrate.
ENV=development

# Server port. The Udacity workspace exposes :3000, which is also the code default.
PORT=3000
